{
  "$schema"           : "vendor/infection/infection/resources/schema.json",
  "source"            : {
    "directories": [
      "src"
    ]
  },
  "staticAnalysisTool": "phpstan",
  "logs"              : {
    "text": "build/infection.txt",
    "html": "build/infection.html"
  },
  "mutators"          : {
    "@default"                   : true,
    "TrueValue"                  : {
      "ignore": [
        "Engine\\Container\\Container::lazy",
        "Engine\\Database\\Schema\\Columns\\BaseColumn::first"
      ]
    },
    "FalseValue"                 : {
      "ignore": [
        "Engine\\Container\\Container::resolve",
        "Engine\\Database\\Schema\\Columns\\BaseColumn::notNull"
      ]
    },
    "Break_"                     : {
      "ignore": [
        "Engine\\Container\\Container::collectDependencies"
      ]
    },
    "Coalesce"                   : {
      "ignore": [
        "Engine\\Container\\Resolvers\\GenericResolver::resolve::56",
        "Engine\\Database\\ConnectionFactory::make::62"
      ]
    },
    "DecrementInteger"           : {
      "ignore": [
        "Engine\\Database\\Query\\Expressions\\ColumnIn::toSql::38",
        "Engine\\Database\\Query\\Expressions\\ColumnNotIn::toSql::38",
        "Engine\\Database\\Query\\Insert::toSql::95",
        "Engine\\Database\\Query\\Insert::toSql::96",
        "Engine\\Values\\ValueGetter::array::64"
      ]
    },
    "IncrementInteger"           : {
      "ignore": [
        "Engine\\Database\\Query\\Expressions\\ColumnIn::toSql::38",
        "Engine\\Database\\Query\\Expressions\\ColumnNotIn::toSql::38",
        "Engine\\Database\\Query\\Insert::toSql::95",
        "Engine\\Database\\Query\\Insert::toSql::96",
        "Engine\\Values\\ValueGetter::array::64"
      ]
    },
    "Assignment"                 : {
      "ignore": [
        "Engine\\Database\\Query\\Concerns\\HasLimitClause::buildLimitClause::45"
      ]
    },
    "ProtectedVisibility"        : {
      "ignore": [
        "Engine\\Database\\Query\\Concerns\\HasWhereClause",
        "Engine\\Database\\Query\\Concerns\\HasHavingClause",
        "Engine\\Database\\Schema\\Concerns\\CanBeUnsigned",
        "Engine\\Database\\Schema\\Concerns\\HasCharsetAndCollation",
        "Engine\\Database\\Schema\\Concerns\\HasComment",
        "Engine\\Database\\Schema\\Concerns\\HasDefault",
        "Engine\\Database\\Schema\\Concerns\\HasLength",
        "Engine\\Database\\Schema\\Columns\\BaseColumn::isGenerated"
      ]
    },
    "ConcatOperandRemoval"       : {
      "ignore": [
        "Engine\\Database\\Schema\\Columns\\DecimalColumn::__construct::102",
        "Engine\\Database\\Schema\\Columns\\IntColumn::__construct::127",
        "Engine\\Database\\Schema\\Columns\\EnumColumn::__construct::82",
        "Engine\\Database\\Schema\\Create\\CreateTable::toSql::153",
        "Engine\\Database\\Schema\\Create\\CreateTable::toSql::179",
        "Engine\\Database\\Schema\\Alter\\AlterTable::toSql::243"
      ]
    },
    "Concat"                     : {
      "ignore": [
        "Engine\\Database\\Schema\\Columns\\DecimalColumn::__construct::102",
        "Engine\\Database\\Schema\\Columns\\IntColumn::__construct::127",
        "Engine\\Database\\Schema\\Columns\\EnumColumn::__construct::82"
      ]
    },
    "LogicalOrAllSubExprNegation": {
      "ignore": [
        "Engine\\Database\\Schema\\Columns\\BaseColumn::addDefaultSyntax"
      ]
    },
    "ReturnRemoval"              : {
      "ignore": [
        "Engine\\Container\\Container::invokeClassMethod::350",
        "Engine\\Database\\Query\\Concerns\\HasJoinClause::buildJoinClause::97",
        "Engine\\Values\\ValueGetter::float::110",
        "Engine\\Values\\ValueGetter::int::135",
        // Removing the early-return when the directory is missing falls through
        // to glob() which returns false on a non-existent dir, then `?: []`
        // produces an empty array, the sort is a no-op, and the same shape is
        // returned at the end of the method. Behaviourally indistinguishable.
        "Engine\\Config\\TomlLoader::readModulesEnabled::146",
        "Engine\\Config\\TomlLoader::readDropIns::219",
        // Removing the socket DSN return falls through to the host-DSN return,
        // producing a different DSN that PDO also rejects. Both paths surface
        // as ConnectionException on the unit-test side. The Linux-only socket
        // integration test (skipped on macOS because Docker Desktop does not
        // proxy unix sockets to host) is the only environment that can
        // distinguish them via a successful socket connection.
        "Engine\\Database\\ConnectionFactory::createMysqlPdoDsn::128"
      ]
    },
    "FunctionCallRemoval"        : {
      "ignore": [
        // glob() already returns paths in alphabetical order on every common
        // filesystem (HFS+/APFS/ext4 with default mount), so removing
        // sort($files, SORT_STRING) is indistinguishable in any practical test
        // environment. Kept defensively to guarantee deterministic ordering on
        // filesystems where readdir order is unsorted (e.g. some network or
        // tmpfs setups).
        "Engine\\Config\\TomlLoader::readModulesEnabled::150",
        "Engine\\Config\\TomlLoader::readDropIns::223"
      ]
    },
    "MethodCallRemoval"          : {
      "ignore": [
        // ConnectionConfig's constructor invariants guarantee these are
        // non-null when socket is null. The asserts are defensive — they
        // encode the invariant for PHPStan and any future maintainer, but
        // they're behaviourally unreachable so the test suite can't kill
        // these mutants without injecting an impossible state.
        "Engine\\Database\\ConnectionFactory::createMysqlPdoDsn::139",
        "Engine\\Database\\ConnectionFactory::createMysqlPdoDsn::140"
      ]
    },
    "MatchArmRemoval"            : {
      "ignore": [
        "Engine\\Database\\ConnectionFactory::createPdo::107"
      ]
    },
    "IfNegation"                 : {
      "ignore": [
        "Engine\\Container\\Container::invokeClassMethod::349"
      ]
    }
  }
}
